msgstr "移到表格内的上一列"

#. Translators: Description for moving to the next Markdown table column.
#: addon\globalPlugins\markdownNavigator\navigator.py:616
msgid "Moves to the next table column"
msgstr "移到表格内的下一列"

#. Translators: Description for moving to the previous Markdown table row.
#: addon\globalPlugins\markdownNavigator\navigator.py:625
