#. Translators: Description for moving to the first Markdown table row.
#: addon\globalPlugins\markdownNavigator\navigator.py:643
msgid "Moves to the first table row"
msgstr "移到表格内的第一行"

#. Translators: Description for moving to the last Markdown table row.
#: addon\globalPlugins\markdownNavigator\navigator.py:652
msgid "Moves to the last table row"
msgstr "移到表格内的最后一行"

#. Translators: Description for moving to the first Markdown table column.
#: addon\globalPlugins\markdownNavigator\navigator.py:661
msgid "Moves to the first table column"
msgstr "移到表格内的第一列"

#. Translators: Description for moving to the last Markdown table column.
#: addon\globalPlugins\markdownNavigator\navigator.py:670
msgid "Moves to the last table column"
msgstr "移到表格内的最后一列"

#. Translators: Description for reading the current Markdown table row.
#: addon\globalPlugins\markdownNavigator\navigator.py:679
msgid "Reads the current row from left to right without moving the caret"
msgstr "在不移动系统光标的情况下，从左到右水平朗读当前行。"

#. Translators: Description for reading the current Markdown table column.
#: addon\globalPlugins\markdownNavigator\navigator.py:689
msgid "Reads the current column from top to bottom without moving the caret"
msgstr "在不移动系统光标的情况下，从上到下垂直朗读当前列。"

#. Translators: Description for reading rightwards from the current Markdown table cell.
#: addon\globalPlugins\markdownNavigator\navigator.py:699
msgid "Reads from the current cell to the end of the row"
msgstr "从当前单元格开始水平向右朗读至当前行的最后一个单元格。"

#. Translators: Description for reading downwards from the current Markdown table cell.
#: addon\globalPlugins\markdownNavigator\navigator.py:709
msgid "Reads from the current cell to the end of the column"
msgstr "从当前单元格开始垂直向下朗读至当前列的最后一个单元格。"

