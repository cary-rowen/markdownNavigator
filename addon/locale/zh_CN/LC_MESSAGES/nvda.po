msgstr "不在表格的单元格中"

#. Translators: Message shown when table navigation reaches the table boundary.
#: addon\globalPlugins\markdownNavigator\navigator.py:532
msgid "Edge of table"
msgstr "表格边缘"

#. Translators: Spoken for an empty Markdown table cell.
#: addon\globalPlugins\markdownNavigator\navigator.py:582
msgid "blank"
msgstr "空白"

#. Translators: Description for moving to the previous Markdown table column.
#: addon\globalPlugins\markdownNavigator\navigator.py:607
